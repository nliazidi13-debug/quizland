# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# prisma
/generated/
/prisma/dev.db
/prisma/migrations/dev/

# cloudflare / opennext
/.open-next/
/.wrangler/
# cloudflare-env.d.ts is checked in, not ignored: `wrangler types` can't run
# in this dev environment (sandboxed subprocess spawn is blocked), so it was
# hand-written from wrangler.jsonc's bindings and needs to travel with the
# repo. Regenerate it with `npm run cf:typegen` if bindings ever change, on
# a machine where that command can run.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
