// Prisma 7 moved the connection URL out of this file and into
// prisma.config.ts; the client now connects through a driver adapter
// instead (see src/lib/db.ts). See https://pris.ly/d/config-datasource
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Without this, the generated client tries to compile its query-compiler
  // WASM at runtime, which Cloudflare Workers blocks ("Wasm code
  // generation disallowed by embedder") — this precompiles it at build
  // time instead. See https://github.com/prisma/prisma/issues/28657
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

// Auth.js (next-auth v5) canonical schema for @auth/prisma-adapter.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Server-side mirror of the localStorage-only PlayerProfile (src/lib/types.ts)
// for signed-in users, so gameplay progress follows the account instead of
// staying stuck on one device/browser. One Profile per User; local-only
// guest/family profiles (no Google account) keep using localStorage as
// before and never touch these tables.
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatar    String   @default("violet-orange")
  xp        Int      @default(0)
  createdAt DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges     ProfileBadge[]
  history    QuizResultEntry[]
  claims     DailyClaim[]
  duelPlayed DuelParticipant[]
}

model ProfileBadge {
  id        String  @id @default(cuid())
  profileId String
  icon      String
  label     String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, icon])
}

model QuizResultEntry {
  id              String   @id @default(cuid())
  profileId       String
  domain          String
  level           Int
  score           Int
  total           Int
  xp              Int
  timeSeconds     Int
  themeErrorsJson String
  completedAt     DateTime

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, completedAt])
}

// One row per (profile, challenge, day) once a daily challenge reward has
// been claimed — progress itself is always recomputed live from history,
// only the "already claimed" fact needs to persist.
model DailyClaim {
  id          String @id @default(cuid())
  profileId   String
  challengeId String
  date        String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, challengeId, date])
}

// A cross-device duel: two signed-in players answer the same fixed
// question set independently (on their own device, their own pace) and
// compare scores once both are done — no per-question real-time sync,
// polled instead, to keep this light on Workers CPU time.
model DuelMatch {
  id              String   @id @default(cuid())
  status          String   @default("waiting") // "waiting" | "active" | "finished"
  domainsJson     String
  level           Int
  questionIdsJson String
  createdAt       DateTime @default(now())

  participants DuelParticipant[]
}

model DuelParticipant {
  id          String    @id @default(cuid())
  matchId     String
  profileId   String
  score       Int?
  xp          Int?
  timeSeconds Int?
  joinedAt    DateTime  @default(now())
  finishedAt  DateTime?

  match   DuelMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([matchId, profileId])
}
